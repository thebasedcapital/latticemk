+      const int a0 = (item & 1) ? mid : 0, a1 = (item & 1) ? pos + 1 : mid;
+      const int per = (a1 - a0 + 31) / 32;
+      const uint2 uq = *reinterpret_cast<const uint2*>(qhead[group] + lane * 4);
+      const __half2 qr0 = as_h2(uq.x), qr1 = as_h2(uq.y);
