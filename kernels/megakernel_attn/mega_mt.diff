+// Each physical warp tiles one inherited virtual partition in registers.
+// Its row is reused by all M queries with matching causal partition ranges.
+// Unlike contiguous CTA tiles, every warp retains independent forward work.
+__device__ CAUSALQUAL void attn_causal(const P2& p, int layer, int cta) {
+  if (cta >= NATTN) return;
+  const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+  const int kvh = cta >> 2, start = position(p, 0);
+  for (int col = 0; col < MT; ++col)
+    attn_setup(column(p, col), layer, start + col, cta, col, warp);
+  __syncthreads(); dt_trace(13);
+  for (int col = 0; col < MT; ++col)
+    attn_append_local(column(p, col), layer, start + col, cta, col, warp);
+  float state[32 / WARPS][MT][6];
+  uint2 qr[MT];
+#pragma unroll
+  for (int col = 0; col < MT; ++col)
+    qr[col] = *reinterpret_cast<const uint2*>(qhead[col] + lane * 4);
+#pragma unroll
+  for (int wave = 0; wave < 32 / WARPS; ++wave) {
+    const int vw = warp + wave * WARPS;
+    int lo[MT], hi[MT], t0 = MAXPOS, t1 = 0;
+#pragma unroll
+    for (int col = 0; col < MT; ++col) {
+      const int pos = start + col, mid = (pos + 2) >> 1;
+      const int a0 = (cta & 1) ? mid : 0, a1 = (cta & 1) ? pos + 1 : mid;
+      const int per = (a1 - a0 + 31) / 32;
+      lo[col] = a0 + vw * per; hi[col] = min(a1, lo[col] + per);
+      t0 = min(t0, lo[col]); t1 = max(t1, hi[col]);
+#pragma unroll
+      for (int j = 0; j < 6; ++j) state[wave][col][j] = j == 5 ? NEG_INF : 0.f;
+    }
+    const View v = column(p, 0);
+    for (int t = t0; t < t1; ++t) {
+      bool used = false;
+      int next = t1;
+#pragma unroll
+      for (int col = 0; col < MT; ++col) {
+        used |= t >= lo[col] && t < hi[col];
+        if (lo[col] > t && lo[col] < hi[col]) next = min(next, lo[col]);
+      }
+      if (!used) { t = next - 1; continue; }
+      const __half* krow = t >= start ? kvloc[t - start] :
+          v.kc + ((int64_t)layer * v.cap + t) * KVROWS + kvh * 128;
+      const __half* vrow = t >= start ? kvloc[t - start] + 128 :
+          v.vc + ((int64_t)layer * v.cap + t) * KVROWS + kvh * 128;
+      const uint2 uk = *reinterpret_cast<const uint2*>(krow + lane * 4);
+      const uint2 uv = *reinterpret_cast<const uint2*>(vrow + lane * 4);
+      const float2 v0 = __half22float2(as_h2(uv.x)), v1 = __half22float2(as_h2(uv.y));
+#pragma unroll
+      for (int col = 0; col < MT; ++col) if (t >= lo[col] && t < hi[col]) {
+        __half2 prod = __hmul2(as_h2(uk.x), as_h2(qr[col].x));
+        prod = __hfma2(as_h2(uk.y), as_h2(qr[col].y), prod);
+        const float s = warp_sum(__low2float(prod) + __high2float(prod)) * 0.08838834764831845f;
+        float* a = state[wave][col];
+        const float mn = fmaxf(a[5], s), corr = a[5] == NEG_INF ? 0.f : __expf(a[5] - mn);
+        const float e = __expf(s - mn);
+        a[0] = a[0] * corr + e * v0.x; a[1] = a[1] * corr + e * v0.y;
+        a[2] = a[2] * corr + e * v1.x; a[3] = a[3] * corr + e * v1.y;
+        a[4] = a[4] * corr + e; a[5] = mn;
+      }
+    }
+  }
+  dt_trace(5);
+  // Merge two query columns concurrently through the two partial groups.
+  const int group_threads = THREADS / ATTGROUP;
+  const int group = threadIdx.x / group_threads, tid = threadIdx.x % group_threads;
+#pragma unroll
+  for (int base = 0; base < MT; base += ATTGROUP) {
+#pragma unroll
+    for (int g = 0; g < ATTGROUP; ++g) if (base + g < MT) {
+#pragma unroll
+      for (int wave = 0; wave < 32 / WARPS; ++wave) {
+        const int vw = warp + wave * WARPS;
+#pragma unroll
+        for (int j = 0; j < 4; ++j) u.wpart[g][vw][lane * 4 + j] = state[wave][base + g][j];
+        if (lane == 0) { u.wpart[g][vw][128] = state[wave][base + g][4]; u.wpart[g][vw][129] = state[wave][base + g][5]; }
+      }
+    }
+    __syncthreads();
+    if (base + group < MT) attn_merge_weights(group, tid);
+    __syncthreads();
+    if (base + group < MT) attn_merge(column(p, base + group), cta, group, tid, group_threads);
+    __syncthreads();
+  }
+  dt_trace(14);
+}
+
+__device__ void attn2(const P2& p, int layer, int cta) {
+  if (p.mode) attn_batch(p, layer, cta);
+  else attn_causal(p, layer, cta);
 }
 
