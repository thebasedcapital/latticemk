+// Materialize new rows locally, so no query reads another CTA's append.
+// Exactly one head-half CTA writes each cache row.
+__device__ void attn_setup(const View& p, int layer, int pos, int item,
+                          int slot, int warp) {
+  const int h = item >> 1, kvh = h >> 1, lane = threadIdx.x & 31;
+  if (warp == 0)
+    norm_rope_row(p, layer, false, pos, p.qkv + h * 128, qhead[slot]);
+  if (warp == 1)
+    norm_rope_row(p, layer, true, pos, p.qkv + QROWS + kvh * 128, kvloc[slot]);
+  if (warp == 2 && lane < 16)
+    *reinterpret_cast<uint4*>(kvloc[slot] + 128 + lane * 8) =
+        *reinterpret_cast<const uint4*>(p.qkv + QROWS + KVROWS + kvh * 128 + lane * 8);
+}
+
+__device__ void attn_append_local(const View& p, int layer, int pos, int item,
+                                 int slot, int warp) {
+  const int lane = threadIdx.x & 31, kvh = item >> 2;
+  if (item % 4 == 0 && warp == 1)
+    *reinterpret_cast<uint2*>(p.kc + ((int64_t)layer * p.cap + pos) * KVROWS +
+                             kvh * 128 + lane * 4) =
+        *reinterpret_cast<const uint2*>(kvloc[slot] + lane * 4);
+  if (item % 4 == 0 && warp == 2 && lane < 16)
+    *reinterpret_cast<uint4*>(p.vc + ((int64_t)layer * p.cap + pos) * KVROWS +
+                             kvh * 128 + lane * 8) =
+        *reinterpret_cast<const uint4*>(kvloc[slot] + 128 + lane * 8);
+}
