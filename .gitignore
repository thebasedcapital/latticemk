.venv/
build/
validator/target/
__pycache__/
*.so
*.o

# Model weights, quantized checkpoints, calibration data (regenerated by reproduce.sh)
*.pt
*.gguf
*.safetensors
*.bin
kvcodec/data/
baselines/exl2/qwen3-*/

